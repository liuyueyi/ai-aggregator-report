# ====================================================
# LLM（OpenAI 兼容协议；支持 OpenAI / DeepSeek / Doubao / OneAPI 等）
# 以下三个通过 _env 变量读取，均无默认值（config.yaml 里配置对应 env 名）
# ====================================================
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=GLM-5.2

# 可选：模拟 LLM（无需 key 也能本地跑通管线），设 L=1 即开启
# AGGR_MOCK_LLM=0

# 可选：GitHub 生态追踪用 token（无则匿名，60 次/小时 限流）
# GITHUB_TOKEN=

# 可选：飞书推送（自定义机器人 Webhook，多个用英文逗号分隔）
# FEISHU_WEBHOOK_URLS=

# 可选：站点产物（manifest.json / feed.xml / 飞书链接）的部署根 URL
# PAGES_URL=https://liuyueyi.github.io/ai-aggregator-report

# 可选：Reddit OAuth（默认走公开 JSON，无需配置）
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=aiaggr/0.1

# ====================================================
# 社交选题源（--article 工作流 / 吃瓜早报）
# ====================================================
# RSSHub 实例地址（默认 https://rsshub.app）。
# 公众号/小红书/头条/Twitter 经 RSSHub 路由接入（公众号/小红书部分路由需自建实例 + token）。
# RSSHUB_BASE_URL=https://rsshub.app

# Twitter/X 专用 API（二选一或都配，配其一才启用；参考 ai-trend-publish 双后端）
# TWITTER_API_KEY=          # TwitterAPI.io 的 X-API-Key
# XQUIK_API_KEY=            # Xquik 的 x-api-key

# 可选：证据补全的正文/搜索抓取（article 工作流），有则走 Jina Reader 认证
# JINA_API_KEY=

# ====================================================
# 文章工作流（--article）配图方案（本期仅生成方案，不接生图 API）
# 后续接真生图时在此配 DashScope / MiniMax key
# ====================================================
# DASHSCOPE_API_KEY=
# MINIMAX_API_KEY=
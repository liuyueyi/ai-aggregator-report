# ====================================================
# LLM（OpenAI 兼容协议；支持 OpenAI / DeepSeek / Doubao / OneAPI 等）
# 以下三个通过 _env 变量读取，均无默认值（config.yaml 里配置对应 env 名）
# ====================================================
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 可选：模拟 LLM（无需 key 也能本地跑通管线），设 L=1 即开启
# AGGR_MOCK_LLM=0

# 可选：GitHub 生态追踪用 token（无则匿名，60 次/小时 限流）
# GITHUB_TOKEN=

# 可选：飞书推送（自定义机器人 Webhook，多个用英文逗号分隔）
# FEISHU_WEBHOOK_URLS=

# 可选：站点产物（manifest.json / feed.xml / 飞书链接）的部署根 URL
# PAGES_URL=https://<user>.github.io/<repo>

# 可选：Reddit OAuth（默认走公开 JSON，无需配置）
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=aiaggr/0.1